# FaithGuard environment template.
# Copy to .env and fill in secrets. NEVER commit .env.

# ---- Auth (REQUIRED in production) ----
# Enables API-key auth on /ask, /detect, /corpus, /corpus/load.
# Clients send it via `x-api-key: ***` or `Authorization: Bearer ***`.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
FG_API_KEY=

*** ---- Rate limiting ----
FG_RATE_LIMIT=60          # max requests per window per key (0 = off)
FG_RATE_WINDOW_S=60

# ---- Logging ----
FG_LOG_LEVEL=INFO         # DEBUG / INFO / WARNING

# ---- LLM generation endpoint (OpenAI-compatible) ----
FG_LLM_BASE_URL=https://api.tokenrouter.com/v1
FG_LLM_MODEL=qwen/qwen3.8-max-free
FG_LLM_KEY_ENV=HERMES_CUSTOM_TOKENROUTER_API_KEY
HERMES_CUSTOM_TOKENROUTER_API_KEY=
*** Or use OpenRouter directly:
# FG_LLM_BASE_URL=https://openrouter.ai/api/v1
# FG_LLM_MODEL=<any-model>
# FG_LLM_KEY_ENV=OPENROUTER_API_KEY
# OPENROUTER_API_KEY=

*** ---- Retrieval / detection models (defaults are fine) ----
# FG_EMBED_MODEL=BAAI/bge-small-en-v1.5
# FG_NLI_MODEL=cross-encoder/nli-deberta-v3-small
# FG_TOP_K=5
# FG_RE_TOP_K=8
# FG_MAX_MITIGATION_ROUNDS=2
# FG_UNSUPPORTED_T=0.5

# ---- Compose ----
# FG_PORT=8000
