# Keep the image lean and avoid shipping local artifacts / secrets.
.git
.gitignore
.venv
venv
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local data artifacts that shouldn't ride along (corpus/models are COPYed explicitly)
data/squad_dev.json
data/feature_cache/
data/qa_gold.json
data/detection_dataset.jsonl

# Reports & local env
reports/
*.env
.env
.env.*

# Editor / OS
.vscode/
.idea/
.DS_Store
